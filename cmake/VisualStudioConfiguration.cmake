# Configuration names also occur in PropertyGroup nodes. Only an
# ItemDefinitionGroup contains the compiler/linker settings for that name.
function(zutilities_vcxproj_configuration output xml configuration)
    set(${output} "" PARENT_SCOPE)
    string(REGEX MATCHALL "<ItemDefinitionGroup[ \t\r\n]+[^>]*>" _groups "${xml}")
    foreach(_group IN LISTS _groups)
        string(FIND "${_group}" "=='${configuration}|Win32'" _matches)
        if(_matches EQUAL -1)
            continue()
        endif()
        string(FIND "${xml}" "${_group}" _position)
        string(SUBSTRING "${xml}" ${_position} -1 _tail)
        string(FIND "${_tail}" "</ItemDefinitionGroup>" _end)
        if(NOT _end EQUAL -1)
            string(SUBSTRING "${_tail}" 0 ${_end} _configuration)
            set(${output} "${_configuration}" PARENT_SCOPE)
        endif()
        return()
    endforeach()
endfunction()
