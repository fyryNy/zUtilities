{
    "configurations": [
        {
            "name": "Union 1.0m msvc-wine x86",
            "includePath": @ZUTILITIES_CPPTOOLS_INCLUDE_PATHS@,
            "defines": [
                "WIN32", "_WIN32", "_M_IX86=600", "_WINDOWS", "_USRDLL",
                "GOTHICPLUGIN_EXPORTS", "_WINDLL", "_MBCS"
            ],
            "compilerPath": @ZUTILITIES_CPPTOOLS_COMPILER@,
            "compilerArgs": ["--target=i686-pc-windows-msvc", "/EHsc"],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-clang-x86",
            "forcedInclude": [
                "${workspaceFolder}/cmake/IntelliSenseContext.h"
            ],
            "browse": {
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
